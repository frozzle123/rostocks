# Required - Bot Configuration
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_server_id_here
OWNER_ID=your_discord_user_id_here

# Optional - Bot Settings
CURRENCY_SYMBOL=$
ORDER_PREFIX=ORD-
PAYMENT_TIMEOUT_MINUTES=30
CATEGORIES=STREAMING,DISCORD,GAMING,DIGITAL,ACCOUNTS,BOTS

# Ticket System - REQUIRED for ticket features
TICKET_CATEGORY_ID=123456789  # Category ID where tickets will be created
SUPPORT_ROLE_ID=123456789     # Role ID that gets pinged for new tickets
ADMIN_ROLE_ID=123456789       # Admin role ID
TICKET_LOG_CHANNEL_ID=123456789  # Channel ID for ticket logs

# Database
DATABASE_PATH=/data/shop.db
